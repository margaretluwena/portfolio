{
  "baseUrl": "http://localhost:3200",
  "viewport": {
    "width": 1128,
    "height": 700,
    "deviceScaleFactor": 2
  },
  "hideSelectors": [
    "nextjs-portal",
    "#__next-build-watcher",
    "[data-nextjs-toast]",
    "[data-next-badge-root]",
    "[data-nextjs-dialog-overlay]"
  ],
  "cursor": {
    "size": 22,
    "speedPxPerSec": 700,
    "minMoveMs": 420,
    "holdBeforeClickMs": 220,
    "clickRippleMs": 420,
    "settleAfterClickMs": 140,
    "fps": 30
  },
  "encode": {
    "fps": 30,
    "maxBytes": 3000000,
    "crfLadder": [
      22,
      25,
      28,
      31,
      34
    ],
    "preset": "slow"
  },
  "out": {
    "videos": "public/videos/prosaic",
    "posters": "public/images/prosaic/posters"
  },
  "stills": [
    {
      "id": "chart-card",
      "route": "/",
      "file": "public/images/prosaic/chart-card.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": ".chart-card",
      "waitMs": 3000,
      "note": "the general-use chart card on its own, for the home card's layers"
    },
    {
      "id": "risk-card",
      "route": "/",
      "file": "public/images/prosaic/risk-card.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block",
      "waitMs": 3000,
      "note": "the first risk category card (Sycophancy), for the home card's layers"
    },
    {
      "id": "weights-table",
      "route": "/methodology",
      "file": "public/images/prosaic/weights-table.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "table.method-table.is-weights",
      "waitMs": 2500,
      "note": "the use-case weighting table from the methodology page"
    },
    {
      "id": "phone",
      "route": "/",
      "file": "public/images/prosaic/phone.png",
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 2,
      "waitMs": 3000,
      "note": "the index on a phone"
    }
  ],
  "shots": [
    {
      "id": "home",
      "route": "/",
      "posterAtMs": 2600,
      "steps": [
        {
          "type": "wait",
          "ms": 1400
        },
        {
          "type": "move",
          "target": "@0.22,0.3"
        },
        {
          "type": "move",
          "target": "@0.78,0.34"
        },
        {
          "type": "move",
          "target": "@0.5,0.22"
        },
        {
          "type": "wait",
          "ms": 700
        },
        {
          "type": "scroll",
          "target": ".chart-card",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1100
        },
        {
          "type": "scroll",
          "target": "#why",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "scroll",
          "target": "#risks",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1400
        }
      ]
    },
    {
      "id": "use-case",
      "route": "/",
      "posterAtMs": 3200,
      "steps": [
        {
          "type": "wait",
          "ms": 1400
        },
        {
          "type": "scroll",
          "target": ".bead-selector",
          "ms": 900,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 500
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Someone having a hard time\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Looking things up\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Everyday advice\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 1800
        }
      ]
    }
  ]
}

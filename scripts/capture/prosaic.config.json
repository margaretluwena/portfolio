{
  "baseUrl": "http://localhost:3200",
  "viewport": {
    "width": 1128,
    "height": 700,
    "deviceScaleFactor": 2
  },
  "hideSelectors": [
    "nextjs-portal",
    "#__next-build-watcher",
    "[data-nextjs-toast]",
    "[data-next-badge-root]",
    "[data-nextjs-dialog-overlay]"
  ],
  "cursor": {
    "size": 22,
    "speedPxPerSec": 650,
    "minMoveMs": 420,
    "holdBeforeClickMs": 220,
    "clickRippleMs": 420,
    "settleAfterClickMs": 140,
    "fps": 30
  },
  "encode": {
    "fps": 30,
    "maxBytes": 3000000,
    "crfLadder": [
      22,
      25,
      28,
      31,
      34
    ],
    "preset": "slow"
  },
  "out": {
    "videos": "public/videos/prosaic",
    "posters": "public/images/prosaic/posters"
  },
  "stills": [
    {
      "id": "chart-card",
      "route": "/",
      "file": "public/images/prosaic/chart-card.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": ".chart-card",
      "waitMs": 3000,
      "note": "the general-use chart card on its own, for the home card's layers"
    },
    {
      "id": "risk-card",
      "route": "/",
      "file": "public/images/prosaic/risk-card.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block",
      "waitMs": 3000,
      "note": "the first risk category card (Sycophancy), for the home card's layers"
    },
    {
      "id": "weights-table",
      "route": "/methodology",
      "file": "public/images/prosaic/weights-table.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "table.method-table.is-weights",
      "waitMs": 2500,
      "note": "the use-case weighting table from the methodology page"
    },
    {
      "id": "phone",
      "route": "/",
      "file": "public/images/prosaic/phone.png",
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 2,
      "waitMs": 3000,
      "note": "the index on a phone"
    },
    {
      "id": "beads",
      "route": "/",
      "file": "public/images/prosaic/beads.png",
      "width": 1456,
      "height": 1016,
      "deviceScaleFactor": 1.5,
      "hide": [
        ".hero-masthead",
        ".hero-title",
        ".hero-subtitle",
        ".hero-standfirst",
        ".bead-selector-heading",
        ".index-section",
        ".home-section"
      ],
      "waitMs": 3200,
      "note": "the bead field alone, at the card's shape, for the home card's background"
    },
    {
      "id": "risks",
      "route": "/",
      "file": "public/images/prosaic/risks.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks",
      "waitMs": 3000,
      "note": "the seven risk categories, each with its chart"
    },
    {
      "id": "risk-0",
      "route": "/",
      "file": "public/images/prosaic/risk-0.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=0",
      "waitMs": 2500
    },
    {
      "id": "risk-1",
      "route": "/",
      "file": "public/images/prosaic/risk-1.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=1",
      "waitMs": 2500
    },
    {
      "id": "risk-2",
      "route": "/",
      "file": "public/images/prosaic/risk-2.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=2",
      "waitMs": 2500
    },
    {
      "id": "risk-3",
      "route": "/",
      "file": "public/images/prosaic/risk-3.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=3",
      "waitMs": 2500
    },
    {
      "id": "risk-4",
      "route": "/",
      "file": "public/images/prosaic/risk-4.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=4",
      "waitMs": 2500
    },
    {
      "id": "risk-5",
      "route": "/",
      "file": "public/images/prosaic/risk-5.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=5",
      "waitMs": 2500
    },
    {
      "id": "risk-6",
      "route": "/",
      "file": "public/images/prosaic/risk-6.png",
      "width": 1128,
      "height": 1000,
      "deviceScaleFactor": 2,
      "selector": "#risks article.block >> nth=6",
      "waitMs": 2500
    },
    {
      "id": "company-openai",
      "route": "/provider/openai",
      "file": "public/images/prosaic/company-openai.png",
      "width": 1128,
      "height": 900,
      "deviceScaleFactor": 2,
      "waitMs": 3000,
      "selector": ".chart-card"
    },
    {
      "id": "phone-risks",
      "route": "/#risks",
      "file": "scripts/capture/prosaic/phone-risks.png",
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 2,
      "waitMs": 3000
    },
    {
      "id": "weights-view",
      "route": "/methodology",
      "file": "public/images/prosaic/weights-view.png",
      "width": 1440,
      "height": 720,
      "deviceScaleFactor": 1.5,
      "scrollTo": "section:has(table.method-table.is-weights)",
      "waitMs": 2500
    },
    {
      "id": "methodology-top",
      "route": "/methodology",
      "file": "public/images/prosaic/methodology-top.png",
      "width": 1440,
      "height": 760,
      "deviceScaleFactor": 1.5,
      "waitMs": 3000
    }
  ],
  "shots": [
    {
      "id": "home",
      "route": "/",
      "posterAtMs": 2400,
      "steps": [
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "move",
          "target": "@0.18,0.28"
        },
        {
          "type": "move",
          "target": "@0.8,0.3"
        },
        {
          "type": "move",
          "target": "@0.45,0.55"
        },
        {
          "type": "move",
          "target": "@0.62,0.2"
        },
        {
          "type": "wait",
          "ms": 500
        },
        {
          "type": "scroll",
          "target": ".chart-card",
          "ms": 1300,
          "block": "start"
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=0"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=4"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=10"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "scroll",
          "target": "#risks",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "move",
          "target": "#risks article.block >> nth=0"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "move",
          "target": "#risks article.block >> nth=1"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "move",
          "target": "#risks article.block >> nth=3"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "scroll",
          "target": "footer.footer",
          "ms": 1600,
          "block": "start"
        },
        {
          "type": "move",
          "target": "@0.5,0.6"
        },
        {
          "type": "wait",
          "ms": 3200
        }
      ]
    },
    {
      "id": "use-case",
      "route": "/",
      "posterAtMs": 2200,
      "steps": [
        {
          "type": "scroll",
          "target": ".bead-selector",
          "ms": 1,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1100
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=1"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=6"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Someone having a hard time\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 1900
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=2"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Looking things up\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 1900
        },
        {
          "type": "move",
          "target": "svg g.selector-bead:has(> text:has-text(\"Everyday advice\")):visible"
        },
        {
          "type": "click"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=0"
        },
        {
          "type": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "id": "risk-page",
      "route": "/category/self-harm-and-crisis",
      "posterAtMs": 1800,
      "steps": [
        {
          "type": "wait",
          "ms": 1600
        },
        {
          "type": "move",
          "target": ".chart-bars .chart-col >> nth=2"
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "scroll",
          "target": "#found",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "scroll",
          "target": "#submeasures",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "scroll",
          "target": "#sources",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "scroll",
          "target": "#limits",
          "ms": 1400,
          "block": "start"
        },
        {
          "type": "wait",
          "ms": 2200
        }
      ]
    }
  ]
}
